# =============================================================================
# ArgonIQ — environment template.
# Copy to `.env` and fill in. never commit a real `.env` (see.gitignore).
# Validated at boot by packages/core-domain → env schema (zod, fail-fast).
# =============================================================================

# --- Runtime --------------------------------------------------------------
NODE_ENV=development
# Public base URL of the portal (used for callbacks, links in notifications).
APP_URL=http://127.0.0.1:3100
# Comma-separated origins allowed to call the API. Default-deny.
ALLOWED_ORIGINS=http://127.0.0.1:3100,http://localhost:3100

# --- Database (PostgreSQL + pgvector) -------------------------------------
# Application role — LEAST PRIVILEGE: no BYPASSRLS, no superuser.
# Tenant isolation is enforced by Row-Level Security + a per-transaction GUC.
DATABASE_URL=postgresql://argoniq:argoniq@localhost:5432/argoniq
# Migration role — owns the schema (used only by drizzle-kit migrate).
DATABASE_MIGRATION_URL=postgresql://argoniq_owner:argoniq@localhost:5432/argoniq

# --- Auth (Better Auth, self-hosted) --------------------------------------
# 32+ byte random secret. Generate: `openssl rand -base64 48`
AUTH_SECRET=replace-me-with-a-long-random-secret
AUTH_TRUST_HOST=true
# Explicitly enable seed personas for a local product demo. Never enable in production.
DEMO_AUTH_ENABLED=false
# Required for production password recovery. Development without SMTP uses a local outbox.
# AUTH_SMTP_URL=smtps://user:password@smtp.example.com:465
# AUTH_EMAIL_FROM=support@example.com

# --- AI SDK -----------------------------------------------------------------
# Safe public-demo default: deterministic local responses and no model spend.
AI_MODE=fake
AI_GATEWAY_API_KEY=
AI_MODEL_CLASSIFY=gateway:openai/gpt-5.6-sol
AI_MODEL_ANSWER=gateway:openai/gpt-5.6-sol
AI_MODEL_REASON=gateway:openai/gpt-5.6-sol
AI_EMBEDDING_MODEL=gateway:openai/text-embedding-3-small
AI_REASONING_EFFORT=low
AI_TIMEOUT_MS=60000
# Optional direct providers: set the corresponding key and provider:model references.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Set AI_MODE=live only after configuring a provider key and model references.

# --- Async worker (pg-boss, backed by the same Postgres) -------------------
# Long-running process; cannot run on serverless. See services/worker.
PGBOSS_DATABASE_URL=postgresql://argoniq:argoniq@localhost:5432/argoniq

# --- Observability ---------------------------------------------------------
LOG_LEVEL=debug
# AI debug transcript: when `true`, every model/embedding interaction (full prompt,
# payload, response, token usage, latency, errors) is appended to a local JSONL file.
# Writes PII/customer text to disk — keep `false` in production; enable for local debug.
AI_DEBUG_TRANSCRIPT=false
AI_DEBUG_TRANSCRIPT_FILE=.ai-debug/transcript.jsonl
# --- Object storage (documents, page-image renders) ------------------------
# Local dev uses the on-disk StoragePort: leave STORAGE_BUCKET EMPTY. A relative
# STORAGE_LOCAL_ROOT is anchored at the monorepo root, so the web app and the worker
# share one folder regardless of their working directory. Set STORAGE_BUCKET (+ the
# S3/R2 vars) only once the object-store StoragePort is implemented for production.
STORAGE_LOCAL_ROOT=.storage
STORAGE_BUCKET=
STORAGE_REGION=eu-central-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Optional support destinations: JSON array scoped by tenantId / companyId.
# Default [] uses the manufacturer's local app inbox.
SUPPORT_ROUTES=[]
# For configured email routes (Resend; verified sending domain required):
# SUPPORT_EMAIL_API_KEY=
# SUPPORT_EMAIL_FROM=support@example.com
