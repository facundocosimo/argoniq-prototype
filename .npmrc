# Reproducible, strict installs. `engine-strict` is valid for both npm and pnpm.
engine-strict=true
# pnpm-specific dependency-graph settings (auto-install-peers, strict-peer-dependencies,
# shamefully-hoist) now live in pnpm-workspace.yaml — keeping them out of .npmrc stops
# `npm` from warning about "unknown project config" keys in this pnpm workspace.
